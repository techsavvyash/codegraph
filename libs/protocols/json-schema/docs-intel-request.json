{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocsIntelParseRequest",
  "type": "object",
  "required": ["source", "content"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["html", "confluence", "text"],
      "description": "Document source type"
    },
    "content": {
      "type": "string",
      "description": "Raw document content"
    },
    "node_key_prefix": {
      "type": "string",
      "description": "Optional prefix for the generated nodeKey"
    }
  }
}
