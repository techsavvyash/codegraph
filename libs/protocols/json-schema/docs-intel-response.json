{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocsIntelParseResponse",
  "type": "object",
  "required": ["node_key", "title", "plain_text", "chunks", "metadata"],
  "properties": {
    "node_key": { "type": "string" },
    "title": { "type": "string" },
    "plain_text": { "type": "string" },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "text", "position", "word_count"],
        "properties": {
          "chunk_id": { "type": "string" },
          "text": { "type": "string" },
          "position": { "type": "integer" },
          "word_count": { "type": "integer" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
