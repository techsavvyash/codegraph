{
  "name": "chat-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/chat-ui",
  "sourceRoot": "apps/chat-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm build", "cwd": "{projectRoot}" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm dev", "cwd": "{projectRoot}" }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm check", "cwd": "{projectRoot}" }
    }
  }
}
