{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true
    },
    "integration": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "smoke": {
      "cache": false,
      "dependsOn": ["build"]
    }
  },
  "defaultBase": "master"
}
